# GovLens environment configuration.
# Copy to .env.local for local development. Never expose OLLAMA_* to the browser
# (no NEXT_PUBLIC_ prefix on purpose — server-only).

# Next.js server URL (used when opening GovLens from another device on the LAN,
# e.g. phone -> http://<mac-ip>:3000). Run with `npm run dev:lan`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Ollama server (server-side only — the browser never calls this).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# SQLite database file (server-side only).
DATABASE_PATH=./.govlens-data/govlens.db
# Inspect past runs: GOVLENS_DATA_DIR is no longer used (use DATABASE_PATH).
