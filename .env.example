# GovLens environment configuration.
# Copy to .env.local for local development. Never expose OLLAMA_* to the browser
# (no NEXT_PUBLIC_ prefix on purpose — server-only).

# Next.js server URL (used when opening GovLens from another device on the LAN,
# e.g. phone -> http://<mac-ip>:3000). Run with `npm run dev:lan`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Ollama server (server-side only — the browser never calls this).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Server-side AI request budget in ms (default 180000); output-token cap
# for structured responses (user document text is never truncated).
OLLAMA_TIMEOUT_MS=180000
OLLAMA_NUM_PREDICT=512

# SQLite database file (server-side only).
DATABASE_PATH=./.govlens-data/govlens.db
# Inspect past runs: GOVLENS_DATA_DIR is no longer used (use DATABASE_PATH).

# Caseworker dashboard access code (server-side only, never NEXT_PUBLIC_*).
# Anyone with this code can view all cases. Use a strong value in production.
CASEWORKER_ACCESS_CODE=govlens-demo

# --- Phase 2: owner-controlled local AI + optional hosted provider ---

# Owner access code: required to use the local AI (scan / analyse / document
# Q&A / translate). Server-side only, never NEXT_PUBLIC_*, never committed.
# There is NO built-in default — owner sign-in (/owner) returns a config error
# until this is set (minimum 8 characters).
OWNER_ACCESS_CODE=
# Owner session lifetime in hours (default 8) and login attempt throttle.
OWNER_SESSION_TTL_HOURS=8
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_WINDOW_MINUTES=15

# Optional hosted Gemini API for PUBLIC-service Q&A over curated public records
# only. Get a key at https://aistudio.google.com/apikey — keep it EMPTY in Git.
# Sensitive documents never go here (the app refuses to send them).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Public Q&A uses Gemini only when this is "true" AND GEMINI_API_KEY is set.
GEMINI_ENABLED=false
# Bounded provider timeout (ms) and output cap for structured answers.
GEMINI_TIMEOUT_MS=540000
GEMINI_MAX_OUTPUT_TOKENS=1024
# Strict server-side data-protection mode for sensitive documents. Defaults to unpaid.
GEMINI_DATA_PROTECTION_MODE=unpaid
# Administrator declaration only; verify Google Cloud billing independently.
GEMINI_PAID_API_BILLING_CONFIRMED=false
# Never enable by default.
GEMINI_ALLOW_SENSITIVE_DOCUMENTS=false
