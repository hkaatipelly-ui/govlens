[Unit]
Description=GovLens Next.js production server
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=govlens
WorkingDirectory=/opt/govlens
EnvironmentFile=/opt/govlens/.env.production
ExecStart=/usr/bin/npm run start -- --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
