# Production environment for GovLens on the remote server.
# Copy to /opt/govlens/.env.production and keep OUT of git (chmod 600).
# Server-side only — never add NEXT_PUBLIC_* secrets here.

# Public app URL (phone/laptop browsers use this)
NEXT_PUBLIC_APP_URL=https://<server-ip-or-domain>

# Local Ollama (Next.js server calls this; browsers never do)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_MS=180000
# Cap on model OUTPUT tokens (user document text is never truncated)
OLLAMA_NUM_PREDICT=512

# SQLite database (persistent server storage, writable by the app user)
DATABASE_PATH=/opt/govlens/data/govlens.db

# Caseworker dashboard access code (server-side only). CHANGE THIS in production.
CASEWORKER_ACCESS_CODE=change-me-to-a-strong-random-value

# Owner access code: required for the owner-controlled local AI (scan, analyse,
# document Q&A, translate). Server-side only, no built-in default (min 8 chars).
OWNER_ACCESS_CODE=change-me-to-a-different-strong-value
OWNER_SESSION_TTL_HOURS=8
OWNER_LOGIN_MAX_ATTEMPTS=5
OWNER_LOGIN_WINDOW_MINUTES=15

# Optional hosted Gemini API for PUBLIC-service Q&A over curated public records.
# Keep the real key OUT of git; sensitive documents are never sent here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ENABLED=false
GEMINI_TIMEOUT_MS=540000
GEMINI_MAX_OUTPUT_TOKENS=1024
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
OWNER_GOOGLE_EMAIL=
